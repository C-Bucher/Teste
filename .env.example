# =============================================================================
# TechConnect 2.0 — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env nem cole valores reais em README/issues.
# Em Configurações → Conexões de API o Admin vê o que está configurado e o que falta.
# =============================================================================

# --- Aplicação -----------------------------------------------------------------
APP_ENV=development                      # development | production (produção recusa subir sem SECRET_KEY)
APP_URL=http://localhost:5173            # endereço do frontend, usado nos links dos e-mails
CORS_ORIGINS=http://localhost:5173
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
# Chave própria para criptografar os segredos do 2FA. Mantenha estável: trocar a SECRET_KEY não deve apagar o 2FA de todos.
ENCRYPTION_KEY=troque-por-outra-chave-aleatoria-longa
# Quantos proxies seus ficam na frente da API (Render/Railway/Nginx = 1). Com 0, o cabeçalho X-Forwarded-For é ignorado.
TRUSTED_PROXY_HOPS=0
AUTH_RATE_LIMIT_PER_MINUTE=20            # tentativas por IP por minuto nas rotas de login/cadastro/recuperação

# --- Banco de dados --------------------------------------------------------------
# Execução manual (uvicorn). Sem DATABASE_URL, usa SQLite em ./techconnect.db
# Supabase / PostgreSQL (padrão de nuvem)
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:SUA_SENHA_AQUI@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# DATABASE_SSL=disable                   # só para um PostgreSQL local sem TLS
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=seu-anon-key-aqui

# Docker Compose: o backend usa o MySQL abaixo automaticamente.
# Para apontar o Docker para o Supabase, descomente e preencha:
# COMPOSE_DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:SUA_SENHA_AQUI@aws-0-us-east-1.pooler.supabase.com:5432/postgres
MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_DATABASE=techconnect
MYSQL_USER=techuser
MYSQL_PASSWORD=troque-esta-senha

# --- Assinaturas e pagamento (Asaas) ------------------------------------------------
# Sem ASAAS_API_KEY: pagamento simulado em desenvolvimento e checkout desligado em produção.
ASAAS_API_KEY=
ASAAS_ENV=sandbox                        # sandbox | production
# Token que você define no painel do Asaas (Integrações → Webhooks), enviado no cabeçalho asaas-access-token.
# URL do webhook: <URL_DA_API>/api/v1/payments/webhook/asaas
ASAAS_WEBHOOK_TOKEN=
TRIAL_DAYS=7                             # dias de teste grátis após o cadastro
GRACE_DAYS=5                             # dias de tolerância após um pagamento vencido antes de bloquear

# --- E-mail transacional (qualquer SMTP: Resend, SendGrid, Amazon SES, Gmail) -----------
# Sem SMTP_HOST os e-mails só aparecem no log (a recuperação de senha não chega ao usuário).
SMTP_HOST=
SMTP_PORT=587                            # 587 = STARTTLS, 465 = SSL
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TechConnect <nao-responda@seudominio.com.br>

# --- IA (Gemini) ---------------------------------------------------------------------
# Em produção use o nível pago da API: no gratuito o Google pode usar os dados enviados.
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-2.5-flash

# --- Bancos (Pluggy, Open Finance) ------------------------------------------------------
# Sem estas variáveis, só a importação de extrato (OFX/CSV) funciona.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Configure o webhook da Pluggy para <URL_DA_API>/api/v1/bank/webhook/pluggy com o cabeçalho X-Webhook-Secret.
PLUGGY_WEBHOOK_SECRET=
# Agendador externo (cron do Supabase, GitHub Actions...): POST <URL_DA_API>/api/v1/bank/sync-all com X-Cron-Secret.
CRON_SECRET=

# --- Arquivos (anexos e exportações) -------------------------------------------------------
# local = disco do servidor (uma instância). s3 = Supabase Storage, AWS S3 ou Cloudflare R2.
STORAGE_BACKEND=local
# STORAGE_DIR=./storage
S3_BUCKET=
S3_ENDPOINT_URL=                         # Supabase: https://<PROJECT_REF>.supabase.co/storage/v1/s3
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Demonstração ----------------------------------------------------------------------
DEMO_REFRESH_DATES=0                     # 1 = traz as datas dos dados demo para hoje a cada inicialização
