SECRET_KEY=troque-por-uma-chave-aleatoria-longa
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=sua-chave-gemini-aqui
# Modelo do Gemini (opcional). Em produção use o nível pago da API: no gratuito o Google pode usar os dados.
GEMINI_MODEL=gemini-2.5-flash

# Agregador de Open Finance (Pluggy). Sem estas variáveis, a conexão automática com bancos fica desligada
# e só a importação de extrato (OFX/CSV) funciona.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Execução manual (uvicorn): banco usado pelo backend. Sem DATABASE_URL, usa SQLite em ./techconnect.db
# Supabase / PostgreSQL (Padrão de Nuvem)
DATABASE_URL=postgresql+asyncpg://postgres.uduyqfctrdlrmsouwpgs:SUA_SENHA_AQUI@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://uduyqfctrdlrmsouwpgs.supabase.co
SUPABASE_ANON_KEY=seu-anon-key-aqui

# Docker Compose: o backend usa o MySQL abaixo automaticamente.
# Para apontar o Docker para o Supabase, descomente e preencha:
# COMPOSE_DATABASE_URL=postgresql+asyncpg://postgres.uduyqfctrdlrmsouwpgs:SUA_SENHA_AQUI@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# MySQL local / Docker (Alternativa)
MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_DATABASE=techconnect
MYSQL_USER=techuser
MYSQL_PASSWORD=troque-esta-senha
# DATABASE_URL=mysql+aiomysql://techuser:troque-esta-senha@db:3306/techconnect
