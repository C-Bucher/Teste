# TechConnect v2.0 — Exemplo de configuração
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o .env com valores reais

# Database
MYSQL_ROOT_PASSWORD=sua_senha_root_aqui
MYSQL_DATABASE=techconnect
MYSQL_USER=techuser
MYSQL_PASSWORD=sua_senha_db_aqui

# Backend — Segurança
SECRET_KEY=gere-uma-chave-aleatoria-longa-aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://redis:6379/0

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@dominio.com
SMTP_PASSWORD=sua-senha-smtp-aqui
SMTP_FROM=TechConnect <noreply@seudominio.com>

# App
APP_NAME=TechConnect
APP_VERSION=2.0.0
APP_ENV=production
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=5242880

# LGPD
DATA_RETENTION_YEARS=5

# IA Consultant (Google Gemini)
GEMINI_API_KEY=sua-chave-gemini-aqui

# Scheduler de alertas automáticos
ALERT_SCHEDULER_ENABLED=true
ALERT_HOUR=8
